[configuration]
entry_symbol = "godot_jit_library_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]
linux.debug.x86_64 = "./libgodot-jit.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./libgodot-jit.linux.template_release.x86_64.so"
linux.debug.arm64 = "./libgodot-jit.linux.template_debug.arm64.so"
linux.release.arm64 = "./libgodot-jit.linux.template_release.arm64.so"
linux.debug.rv64 = "./libgodot-jit.linux.template_debug.rv64.so"
linux.release.rv64 = "./libgodot-jit.linux.template_release.rv64.so"
windows.debug.x86_64 = "./libgodot-jit.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./libgodot-jit.windows.template_release.x86_64.dll"
macos.debug.arm64 = "./libgodot-jit.macos.template_debug.arm64.dylib"
macos.release.arm64 = "./libgodot-jit.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "./libgodot-jit.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "./libgodot-jit.macos.template_release.x86_64.dylib"
