[configuration]
entry_symbol = "godot_jit_library_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://addons/godot_jit/bin/debug/libgodot-jit.linux.x86_64.so"
linux.release.x86_64 = "res://addons/godot_jit/bin/release/libgodot-jit.linux.x86_64.so"
linux.debug.arm64 = "res://addons/godot_jit/bin/debug/libgodot-jit.linux.arm64.so"
linux.release.arm64 = "res://addons/godot_jit/bin/release/libgodot-jit.linux.arm64.so"
linux.debug.rv64 = "res://addons/godot_jit/bin/debug/libgodot-jit.linux.rv64.so"
linux.release.rv64 = "res://addons/godot_jit/bin/release/libgodot-jit.linux.rv64.so"
windows.debug.x86_64 = "res://addons/godot_jit/bin/debug/libgodot-jit.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/godot_jit/bin/release/libgodot-jit.windows.x86_64.dll"
macos.debug.arm64 = "res://addons/godot_jit/bin/debug/libgodot-jit.macos.arm64.dylib"
macos.release.arm64 = "res://addons/godot_jit/bin/release/libgodot-jit.macos.arm64.dylib"
macos.debug.x86_64 = "res://addons/godot_jit/bin/debug/libgodot-jit.macos.x86_64.dylib"
macos.release.x86_64 = "res://addons/godot_jit/bin/release/libgodot-jit.macos.x86_64.dylib"
